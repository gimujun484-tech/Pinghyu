---------------------------------------------------------------- INPUT
conn(UIS.InputBegan, function(i, gpe)
    if capture and i.UserInputType == Enum.UserInputType.Keyboard then
        local fn = capture
        capture = nil
        fn(i.KeyCode)
        return
    end
    if gpe then return end
    local name = i.KeyCode.Name
    if name == Cfg.Misc.ToggleUI then
        Main.Visible = not Main.Visible
    elseif name == Cfg.Misc.ToggleFarm then
        Cfg.Farm.Enabled = not Cfg.Farm.Enabled
        State.target = nil
        refreshAll()
    end
end)
 
pcall(function() if getgenv then getgenv().PinghyuHubUnload = unload end end)
