local function getRoot() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getEquippedTool() local c = LP.Character return c and c:FindFirstChildOfClass("Tool") end

local function kwMatch(list, text)
    text = string.lower(text)
    for w in string.gmatch(string.lower(list), "[^,%s]+") do
        if string.find(text, w, 1, true) then return true end
    end
    return false
end

local function isTeammate(plr)
    return LP.Team ~= nil and plr.Team == LP.Team
end

