-- ========== ENERGY 강화 ==========

local function ScanEnergy()
    energyObjects = {}
    local function check(obj)
        if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("NumberAttribute") then
            local n = tostring(obj.Name):lower()
            if n:find("energy") or n:find("stamina") or n:find("power") or n:find("mana") or 
               n:find("gauge") or n:find("fuel") or n:find("bar") or n:find("cost") or n:find("sp") then
                table.insert(energyObjects, obj)
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _,v in pairs(char:GetDescendants()) do check(v) end
    end
    for _,v in pairs(LocalPlayer:GetDescendants()) do check(v) end
    -- PlayerGui도 훑기
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _,v in pairs(pg:GetDescendants()) do check(v) end
    end
end

local function ForceEnergy()
    if not S.InfEnergy then return end
    for _, obj in ipairs(energyObjects) do
        pcall(function()
            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                obj.Value = 999999
            end
        end)
    end
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            char:SetAttribute("Energy", 999999)
            char:SetAttribute("Stamina", 999999)
            char:SetAttribute("Power", 999999)
            char:SetAttribute("SP", 999999)
        end)
    end
end

-- 값 변경 감지해서 다시 강제
local function HookEnergy()
    for _, obj in ipairs(energyObjects) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            pcall(function()
                obj:GetPropertyChangedSignal("Value"):Connect(function()
                    if S.InfEnergy and obj.Value < 500000 then
                        obj.Value = 999999
                    end
                end)
            end)
        end
    end
end

