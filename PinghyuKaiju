task.spawn(function()
    while alive do
        local S = Cfg.Skills
        task.wait(math.max(S.CycleInterval, 0.05))
        local go = S.Enabled
        if not go and Cfg.Farm.Enabled and State.target then
            local root = getRoot()
            if root then go = (State.target.Position - root.Position).Magnitude <= S.Range end
        end
        if not go and Cfg.Hunt.Enabled and HuntState.target then
            local root = getRoot()
            local c = HuntState.target.Character
            local hroot = c and c:FindFirstChild("HumanoidRootPart")
            if root and hroot then go = (hroot.Position - root.Position).Magnitude <= S.Range end
        end
        if go then
            for _, k in ipairs(SKILL_ORDER) do
                if not alive then break end
                if S.Keys[k] and os.clock() - (lastPress[k] or 0) >= S.Cooldowns[k] then
                    lastPress[k] = os.clock()
                    pressKey(k, S.HoldTime)
                    task.wait(S.KeyGap)
                end
            end
        end
    end
end)
 
---------------------------------------------------------------- ENERGY / CELL (client-side value scan+force)
-- Same trick for both: find NumberValue/IntValue instances (and numeric attributes) whose
-- name matches a keyword list, then keep overwriting them. Only works if the game trusts
-- that client-visible value as the real one; if the server tracks it authoritatively
-- (most currencies do), this will get overwritten back or flagged. Test it and tell me
-- what happens - if it doesn't stick, we need to look at the actual RemoteEvent that
-- grants Cells instead of the display value.
local hookedEnergy, energyObjs = {}, {}
local hookedCell, cellObjs = {}, {}
 
local function parseList(str)
    local list = {}
    for w in string.gmatch(string.lower(str), "[^,%s]+") do list[#list + 1] = w end
    return list
end
 
local function nameMatches(name, kws)
    name = string.lower(name)
    for _, w in ipairs(kws) do
        if string.find(name, w, 1, true) then return true end
    end
    return false
end
 
local function scanValues(keywordStr, hookedTbl, objTbl, enabledFn, valueFn)
    local kws = parseList(keywordStr)
    for k in pairs(objTbl) do objTbl[k] = nil end
    if #kws == 0 then return end
    local function check(o)
        if (o:IsA("NumberValue") or o:IsA("IntValue")) and nameMatches(o.Name, kws) then
            objTbl[#objTbl + 1] = o
            if not hookedTbl[o] then
                hookedTbl[o] = true
                conn(o:GetPropertyChangedSignal("Value"), function()
                    if enabledFn() and o.Value < valueFn() * 0.5 then
                        o.Value = valueFn()
                    end
                end)
            end
        end
    end
    for _, o in ipairs(LP:GetDescendants()) do check(o) end
    local c = LP.Character
    if c then for _, o in ipairs(c:GetDescendants()) do check(o) end end
    -- leaderstats / currency folders often live directly under the player, not nested
    local ls = LP:FindFirstChild("leaderstats")
    if ls then for _, o in ipairs(ls:GetChildren()) do check(o) end end
end
 
local function forceValues(objTbl, keywordStr, value)
    local kws = parseList(keywordStr)
    for _, o in ipairs(objTbl) do
        if o.Parent then pcall(function() o.Value = value end) end
    end
    local function attrs(inst)
        if not inst then return end
        for name, val in pairs(inst:GetAttributes()) do
            if type(val) == "number" and nameMatches(name, kws) then inst:SetAttribute(name, value) end
        end
    end
    attrs(LP.Character)
    attrs(LP)
end
 
local function scanEnergy() scanValues(Cfg.Misc.EnergyKeywords, hookedEnergy, energyObjs, function() return Cfg.Misc.InfEnergy end, function() return Cfg.Misc.EnergyValue end) end
local function forceEnergy() forceValues(energyObjs, Cfg.Misc.EnergyKeywords, Cfg.Misc.EnergyValue) end
local function scanCell() scanValues(Cfg.Misc.CellKeywords, hookedCell, cellObjs, function() return Cfg.Misc.InfCell end, function() return Cfg.Misc.CellValue end) end
local function forceCell() forceValues(cellObjs, Cfg.Misc.CellKeywords, Cfg.Misc.CellValue) end
 
task.spawn(function()
    task.wait(2)
    while alive do
        if Cfg.Misc.InfEnergy then pcall(scanEnergy) end
        if Cfg.Misc.InfCell then pcall(scanCell) end
        task.wait(4)
    end
end)
task.spawn(function()
    while alive do
        if Cfg.Misc.InfEnergy then pcall(forceEnergy) end
        if Cfg.Misc.InfCell then pcall(forceCell) end
        task.wait(0.2)
    end
end)
conn(LP.CharacterAdded, function()
