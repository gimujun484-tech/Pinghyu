---------------------------------------------------------------- TARGET CACHE
local function admit(o)
    if not o:IsA("BasePart") then return end
    if not o.Anchored or not o.CanCollide then return end
    if o.Size.Magnitude < 6 then return end
    local m = o:FindFirstAncestorOfClass("Model")
    if m and m:FindFirstChildOfClass("Humanoid") then return end
    Cache[o] = true
end
 
task.spawn(function()
    local n = 0
    for _, o in ipairs(Workspace:GetDescendants()) do
        if not alive then return end
        admit(o)
        n += 1
        if n % 400 == 0 then task.wait() end
    end
end)
conn(Workspace.DescendantAdded, admit)
conn(Workspace.DescendantRemoving, function(o) Cache[o] = nil end)
 
local function pickTarget(root)
    local T, F = Cfg.Target, Cfg.Farm
    local rp, now = root.Position, os.clock()
    local rangeSq, minSq = F.Range * F.Range, T.MinDist * T.MinDist
    local best, bestScore, count = nil, -math.huge, 0
    for part in pairs(Cache) do
        if part.Parent then
            local bl = Blacklist[part]
            if not bl or bl < now then
                if bl then Blacklist[part] = nil end
                local s, p = part.Size, part.Position
                local mag = s.Magnitude
                if mag >= T.MinSize and mag <= T.MaxSize and s.Y >= T.MinY and s.Y <= T.MaxY and p.Y <= T.MaxWorldY then
                    local d = p - rp
                    local dsq = d:Dot(d)
                    if dsq <= rangeSq and dsq >= minSq then
                        if F.Priority == "Random" then
                            count += 1
                            if math.random(count) == 1 then best = part end
                        else
                            local score = (F.Priority == "Largest") and mag or -dsq
                            if score > bestScore then bestScore, best = score, part end
                        end
                    end
                end
            end
        end
    end
    return best
end
 
---------------------------------------------------------------- AUTOFARM
conn(RunService.Heartbeat, function()
    local F = Cfg.Farm
    if not F.Enabled then State.target = nil return end
    local root = getRoot()
    if not root then return end
    local now = os.clock()
    local t = State.target
 
    if t then
        if not t.Parent then
            t = nil
        elseif F.TargetTimeout > 0 and now - State.since > F.TargetTimeout then
            Blacklist[t] = now + F.BlacklistTime
            t = nil
        elseif (t.Position - root.Position).Magnitude > F.Range + 20 then
            t = nil
        end
    end
 
    if not t then
        State.target = nil
        if now - State.lastPick < F.RetargetCD then return end
        State.lastPick = now
        t = pickTarget(root)
        if not t then return end
        State.target, State.since = t, now
        local off = Vector3.new(root.Position.X - t.Position.X, 0, root.Position.Z - t.Position.Z)
        State.side = off.Magnitude > 0.5 and off.Unit or Vector3.xAxis
    end
 
    local pos = t.Position
    local edge = math.max(t.Size.X, t.Size.Z) * 0.5
    local desired = pos + State.side * (edge + F.SideDist) + Vector3.new(0, F.Height, 0)
    if (root.Position - desired).Magnitude > F.RepositionThreshold then
        root.CFrame = CFrame.new(desired, pos)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end)
 
---------------------------------------------------------------- HUNT (PvP auto-kill)
-- Finds other players, walks up to engage range, and lets the skill loop below fire on them.
local HuntState = {target = nil, lastPick = 0}
 
local function getPlayerHealth(plr)
    local c = plr.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    return hum.Health, hum
end
 
local function pickHuntTarget(root)
    local H = Cfg.Hunt
    local rp = root.Position
    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local c = plr.Character
            local hp, hum = getPlayerHealth(plr)
            local hroot = c and c:FindFirstChild("HumanoidRootPart")
            if c and hum and hroot and hp and hp > 0 then
                local d = (hroot.Position - rp).Magnitude
                if d <= H.Range then
                    local score
                    if H.Priority == "LowestHealth" then score = hp
                    else score = d end
                    if score < bestScore then bestScore, best = score, plr end
                end
            end
        end
    end
    return best
end
 
conn(RunService.Heartbeat, function()
    local H = Cfg.Hunt
    if not H.Enabled then HuntState.target = nil return end
    local root = getRoot()
    if not root then return end
    local now = os.clock()
 
    local plr = HuntState.target
    if plr then
        local c = plr.Character
        local hp = getPlayerHealth(plr)
        local hroot = c and c:FindFirstChild("HumanoidRootPart")
        if not c or not hroot or not hp or hp <= 0 then
            plr = nil
        elseif (hroot.Position - root.Position).Magnitude > H.Range + 30 then
            plr = nil
        end
    end
 
    if now - HuntState.lastPick >= H.RetargetCD then
        HuntState.lastPick = now
        local candidate = pickHuntTarget(root)
        if candidate and candidate ~= plr then
            if not plr then
                plr = candidate
            else
                -- only steal the current target if the new one is meaningfully closer
                local oldRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                local newRoot = candidate.Character and candidate.Character:FindFirstChild("HumanoidRootPart")
                if oldRoot and newRoot then
                    local oldD = (oldRoot.Position - root.Position).Magnitude
                    local newD = (newRoot.Position - root.Position).Magnitude
                    if oldD - newD >= H.SwitchIfCloser then plr = candidate end
                end
            end
        end
    end
 
    HuntState.target = plr
    if not plr then return end
 
    local hroot = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hroot then return end
    local headPos = hroot.Position + Vector3.new(0, 2.5, 0) -- rough head offset above root
 
    if Cfg.Hunt.HoverAbove then
        local desired = headPos + Vector3.new(0, Cfg.Hunt.HoverHeight, 0)
        if (root.Position - desired).Magnitude > Cfg.Hunt.HoverSnap then
            root.CFrame = CFrame.new(desired, headPos)
            root.AssemblyLinearVelocity = Vector3.zero
        else
            -- close enough to the hover spot: just keep facing down at them, don't fight gravity every frame
            root.CFrame = CFrame.new(root.Position, headPos)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    else
        local d = (hroot.Position - root.Position).Magnitude
        if d > Cfg.Hunt.EngageDist then
            local dir = (hroot.Position - root.Position)
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude > 0.1 then
                local desired = hroot.Position - dir.Unit * Cfg.Hunt.EngageDist
                root.CFrame = CFrame.new(Vector3.new(desired.X, root.Position.Y, desired.Z), Vector3.new(hroot.Position.X, root.Position.Y, hroot.Position.Z))
            end
        end
    end
end)
 
