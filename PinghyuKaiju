---------------------------------------------------------------- HELD ITEM TRACKING + REMOTES
-- Found with Remote Spy: this game has no Tool objects. Items are equipped with
-- ItemsRemotes.EquipTool("Item Name"), swords hit with ItemsRemotes.SwordHit(targetModel, "Sword Name"),
-- and blocks/beds are mined with ItemsRemotes.MineBlock(...). So we call those remotes directly.
local SWORD_WORDS = "sword,blade,knife,katana,dagger"
local itemKnown, currentItem, lastSword, lastPickaxe = false, nil, nil, nil
local lastMouseDown = 0

local function trackEquip(name)
    itemKnown = true
    if type(name) == "string" then
        currentItem = name
        if kwMatch(SWORD_WORDS, name) then lastSword = name end
        if string.find(string.lower(name), "pickaxe", 1, true) then lastPickaxe = name end
    else
        currentItem = nil
    end
end

local remoteCache = {}
local function getItemRemote(name)
    local r = remoteCache[name]
    if r and r.Parent then return r end
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    local items = remotes and remotes:FindFirstChild("ItemsRemotes")
    r = items and items:FindFirstChild(name)
    remoteCache[name] = r
    return r
end

local function genv(key)
    local ok, v = pcall(function() return getgenv and getgenv()[key] end)
    return ok and v or nil
end
-- if it guesses the wrong item name, set it yourself:  getgenv().BadFightSword = "Iron Sword"
local function swordName() return genv("BadFightSword") or lastSword or "Wooden Sword" end
local function pickaxeName() return genv("BadFightPickaxe") or lastPickaxe or "Wooden Pickaxe" end

local function recentlySwinging()
    return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or (os.clock() - lastMouseDown) < 0.4
end

---------------------------------------------------------------- KILL AURA
local lastTargetPlr, lastTargetAt = nil, 0

local function targetModel(plr)
    local container = workspace:FindFirstChild("PlayersContainer")
    return (container and container:FindFirstChild(plr.Name)) or plr.Character
end

local function nearestEnemy(root, maxDist)
    local best, bestD = nil, maxDist or math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not isTeammate(plr) and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hroot = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hroot and hum.Health > 0 then
                local d = (hroot.Position - root.Position).Magnitude
                if d < bestD then bestD, best = d, {plr = plr, hum = hum, root = hroot} end
            end
        end
    end
    return best
end

-- Angle: 360 means all around you (including behind). Smaller values only allow a cone in front.
local function withinAngle(root, pos)
    local a = Cfg.Combat.Angle
    if a >= 360 then return true end
    local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    local to = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
    if look.Magnitude < 0.01 or to.Magnitude < 0.01 then return true end
    local ang = math.deg(math.acos(math.clamp(look.Unit:Dot(to.Unit), -1, 1)))
    return ang <= a / 2
end

local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
local function hasLineOfSight(root, targetChar, targetPos)
    local ignore = {LP.Character}
    if targetChar then ignore[#ignore + 1] = targetChar end
    losParams.FilterDescendantsInstances = ignore
    return workspace:Raycast(root.Position, targetPos - root.Position, losParams) == nil
end

local function pickTarget(root)
    local C2 = Cfg.Combat
    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not isTeammate(plr) and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hroot = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hroot and hum.Health > 0 then
                local d = (hroot.Position - root.Position).Magnitude
                if d <= C2.Range and withinAngle(root, hroot.Position)
                    and (C2.ThroughWalls or hasLineOfSight(root, plr.Character, hroot.Position)) then
                    local score = C2.Priority == "LowestHealth" and hum.Health or d
                    if score < bestScore then
                        bestScore, best = score, {plr = plr, hum = hum, root = hroot, model = targetModel(plr)}
                    end
                end
            end
        end
    end
    return best
end

-- Optional swing animation: tweens your right shoulder joint forward and back. Purely visual and
-- best-effort (rig/game dependent). The hit itself is the SwordHit remote and never needs it.
local swingBusy = false
local function playSwingAnimation()
    if swingBusy then return end
    local char = LP.Character
    if not char then return end
    local motor = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
    if not motor or not motor:IsA("Motor6D") then return end
    swingBusy = true
    task.spawn(function()
        local orig = motor.C0
        local isR6 = motor.Parent ~= nil and motor.Parent.Name == "Torso"
        local rot = isR6 and CFrame.Angles(0, 0, math.rad(105)) or CFrame.Angles(math.rad(105), 0, 0)
        pcall(function()
            local down = TweenService:Create(motor, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {C0 = orig * rot})
            down:Play()
            down.Completed:Wait()
            local up = TweenService:Create(motor, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {C0 = orig})
            up:Play()
            up.Completed:Wait()
        end)
        pcall(function() motor.C0 = orig end)
        swingBusy = false
    end)
end

local lastSwing = 0
conn(RunService.Heartbeat, function()
    local C2 = Cfg.Combat
    if not C2.KillAura then return end
    local root = getRoot()
    if not root then return end

    local now = os.clock()
    if now - lastSwing < C2.SwingTime then return end
    if C2.SwingOnly and not recentlySwinging() then return end
    if C2.LimitItem and itemKnown and not (currentItem and kwMatch(SWORD_WORDS, currentItem)) then return end

    local target = pickTarget(root)
    if not target or not target.model then return end

    local remote = getItemRemote("SwordHit")
    if not remote then
        logOnce("nosword", "ReplicatedStorage.Remotes.ItemsRemotes.SwordHit was not found.")
        return
    end

    lastSwing = now
    lastTargetPlr, lastTargetAt = target.plr, now
    if C2.FaceTarget then
        local t = target.root.Position
        root.CFrame = CFrame.new(root.Position, Vector3.new(t.X, root.Position.Y, t.Z))
    end
    local sword = swordName()
    for _ = 1, C2.MultiHit do
        pcall(function() remote:FireServer(target.model, sword) end)
    end
    if C2.Animation and not C2.NoSwing then playSwingAnimation() end
    logOnce("hit", "SwordHit -> " .. target.model.Name .. " with " .. sword)
end)

---------------------------------------------------------------- SPEED
-- Reasserts WalkSpeed the instant the game changes it, remembers the speed you had before, and
-- puts that exact value back when you turn it off.
local wasSpeedOn, origWalkSpeed = false, nil
local speedHum, speedConn = nil, nil
conn(RunService.Heartbeat, function()
    local hum = getHum()
    if not hum then return end
    if speedHum ~= hum then
        speedHum = hum
        if speedConn then speedConn:Disconnect() end
        speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if alive and Cfg.Movement.SpeedEnabled and hum.WalkSpeed ~= Cfg.Movement.WalkSpeed then
                hum.WalkSpeed = Cfg.Movement.WalkSpeed
            end
        end)
        conns[#conns + 1] = speedConn
        wasSpeedOn = false
    end
    if Cfg.Movement.SpeedEnabled then
        if not wasSpeedOn then
            origWalkSpeed = hum.WalkSpeed
            wasSpeedOn = true
        end
        if hum.WalkSpeed ~= Cfg.Movement.WalkSpeed then hum.WalkSpeed = Cfg.Movement.WalkSpeed end
    elseif wasSpeedOn then
        wasSpeedOn = false
        hum.WalkSpeed = origWalkSpeed or 16
    end
end)

