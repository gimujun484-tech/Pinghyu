---------------------------------------------------------------- FLY
-- Direction: WASD along where the camera faces on the flat plane (looking up does NOT make you
-- climb), Space = up, LeftControl = down. Every FlyGroundTouchInterval seconds it drops to the
-- ground for a moment and then goes right back UP to the altitude it was at. If nothing solid is
-- below (void/gap) it skips that drop instead of letting you fall.
local flyPhase, flyTimer, flySavedY, flyTouchEnd = "fly", 0, 0, 0
local flyRay = RaycastParams.new()
flyRay.FilterType = Enum.RaycastFilterType.Exclude

conn(RunService.RenderStepped, function(dt)
    local M = Cfg.Movement
    local hum, root = getHum(), getRoot()
    if not M.FlyEnabled or not hum or not root then
        flyHud.Visible = false
        flyPhase, flyTimer = "fly", 0
        return
    end
    flyHud.Visible = true
    local cam = workspace.CurrentCamera
    flyRay.FilterDescendantsInstances = {LP.Character}

    if flyPhase == "touch" then
        root.AssemblyLinearVelocity = Vector3.zero
        flyHudText.Text = "FLY  touching ground..."
        flyHudFill.Size = UDim2.new(1, 0, 1, 0)
        if os.clock() >= flyTouchEnd then
            local p = root.Position
            local rot = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(Vector3.new(p.X, flySavedY, p.Z)) * rot
            root.AssemblyLinearVelocity = Vector3.zero
            flyPhase, flyTimer = "fly", 0
        end
        return
    end

    flyTimer += dt
    local remaining = math.max(M.FlyGroundTouchInterval - flyTimer, 0)
    flyHudText.Text = ("FLY  ground touch in %.1fs"):format(remaining)
    flyHudFill.Size = UDim2.new(math.clamp(flyTimer / M.FlyGroundTouchInterval, 0, 1), 0, 1, 0)

    local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
    local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
    if look.Magnitude > 0 then look = look.Unit end
    if right.Magnitude > 0 then right = right.Unit end
    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += look end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= look end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= right end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += right end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
    if dir.Magnitude > 0 then
        root.CFrame = root.CFrame + dir.Unit * M.FlySpeed * dt
    end
    root.AssemblyLinearVelocity = Vector3.zero

    if flyTimer >= M.FlyGroundTouchInterval then
        local result = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), flyRay)
        if result then
            flySavedY = root.Position.Y
            local rot = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0)) * rot
            flyPhase = "touch"
            flyTouchEnd = os.clock() + M.FlyGroundTouchDuration
        else
            flyTimer = 0
        end
    end
end)

---------------------------------------------------------------- LONG JUMP
-- Switch it on (or press its keybind) and you launch in an arc that lands on the nearest enemy,
-- or straight ahead if nobody is around, then it turns itself back off.
local ljState = nil
local function finishLongJump()
    ljState = nil
    Cfg_LJ.Enabled = false
    local e = modules["Long Jump"]
    if e and e.refresh then e.refresh() end
end

conn(RunService.Heartbeat, function(dt)
    local root = getRoot()
    if Cfg_LJ.Enabled and not ljState then
        if not root then
            finishLongJump()
            return
        end
        local target = nearestEnemy(root, 400)
        local dest
        if target then
            dest = target.root.Position
        else
            local look = workspace.CurrentCamera.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            dest = root.Position + (flat.Magnitude > 0 and flat.Unit or Vector3.zAxis) * 60
        end
        local g = workspace.Gravity
        local delta = dest - root.Position
        local horiz = Vector3.new(delta.X, 0, delta.Z)
        local hd = horiz.Magnitude
        local T = math.clamp(hd / math.max(Cfg_LJ.Speed, 1), 0.45, 2.2)
        local vy = (delta.Y + 0.5 * g * T * T) / T
        local vh = hd > 0.1 and horiz.Unit * (hd / T) or Vector3.zero
        ljState = {vh = vh, t = 0, T = T}
        root.AssemblyLinearVelocity = Vector3.new(vh.X, vy, vh.Z)
    elseif ljState then
        ljState.t += dt
        if not root or ljState.t >= ljState.T then
            finishLongJump()
        else
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(ljState.vh.X, v.Y, ljState.vh.Z)
        end
    end
end)

