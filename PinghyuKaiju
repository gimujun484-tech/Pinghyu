local keyMap = {
    ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two, ["3"] = Enum.KeyCode.Three,
    ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five, ["R"] = Enum.KeyCode.R, ["T"] = Enum.KeyCode.T
}
local skillOrder = {"1","2","3","4","5","R","T"}

local function FireSelected()
    for _, k in ipairs(skillOrder) do
        if S.Skills[k] then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, keyMap[k], false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, keyMap[k], false, game)
            end)
            task.wait(0.07)
        end
    end
end

local function GetBuildings()
    local list = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Anchored and obj.CanCollide then
            local s = obj.Size
            if s.Magnitude > 18 and s.Magnitude < 260 and s.Y > 2.5 and s.Y < 65 and obj.Position.Y < 160 then
                table.insert(list, obj)
            end
        end
    end
    return list
end

local lastFarm = 0
local currentTarget = nil
local lastSkillTime = 0

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if not S.AutoFarm then
        currentTarget = nil
        return
    end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if not currentTarget or not currentTarget.Parent or (root.Position - currentTarget.Position).Magnitude > S.AttackDist + 20 then
        if tick() - lastFarm < S.FarmCD then return end
        lastFarm = tick()
        local list = GetBuildings()
        local best, bestD = nil, 9999
        for _, b in ipairs(list) do
            local d = (root.Position - b.Position).Magnitude
            if d < bestD and d > 8 then
                bestD = d
                best = b
            end
        end
        currentTarget = best
    end

    if currentTarget then
        local pos = currentTarget.Position
        local side = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z)
        if side.Magnitude < 0.5 then side = Vector3.new(1, 0, 0) end
        side = side.Unit
        local targetPos = pos + side * (currentTarget.Size.X * 0.5 + S.FarmDist) + Vector3.new(0, S.FarmHeight, 0)
        root.CFrame = CFrame.new(targetPos, pos)

        if tick() - lastSkillTime > 0.5 then
            lastSkillTime = tick()
            FireSelected()
        end
    end
end))

task.spawn(function()
    while true do
        task.wait(0.55)
        if S.AutoSkill then
            FireSelected()
        end
    end
end)

