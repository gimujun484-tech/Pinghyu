    local body = new("ScrollingFrame", {Size = UDim2.new(1, -4, 1, -34), Position = UDim2.new(0, 2, 0, 32), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, card)
    new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, body)
    new("UIPadding", {PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingBottom = UDim.new(0, 6)}, body)
    columns[name] = {frame = card, open = false}
    return body
end

local function toggleColumn(name, lbl, btn)
    local col = columns[name]
    col.open = not col.open
    col.frame.Visible = col.open
    lbl.TextColor3 = col.open and C.accent or C.dim
    btn.BackgroundColor3 = col.open and C.sidebarSelected or C.sidebar
end

-- explicit LayoutOrder numbers so rows never depend on tie-breaking
local function ord(parent)
    local n = (parent:GetAttribute("n") or 0) + 1
    parent:SetAttribute("n", n)
    return n
end

local function miniSlider(parent, label, cfgTable, key, min, max, step)
    local f = new("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = ord(parent)}, parent)
    local lbl = new("TextLabel", {Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, Text = label .. ": " .. tostring(cfgTable[key]), TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local track = new("Frame", {Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 15), BackgroundTransparency = 1, Active = true}, f)
    local bar = new("Frame", {Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), BackgroundColor3 = C.track}, track)
    corner(bar, 2)
    local fill = new("Frame", {Size = UDim2.new(math.clamp((cfgTable[key] - min) / (max - min), 0, 1), 0, 1, 0), BackgroundColor3 = C.accent}, bar)
    corner(fill, 2)
    local dragging = false
    local function setFrom(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
        v = tonumber(string.format("%.3f", v))
        cfgTable[key] = v
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = label .. ": " .. tostring(v)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Main.Draggable = false
            setFrom(i.Position.X)
        end
    end)
    conn(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            Main.Draggable = true
        end
    end)
    conn(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFrom(i.Position.X)
        end
    end)
end

local function miniToggle(parent, label, cfgTable, key)
    local f = new("Frame", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = ord(parent)}, parent)
    new("TextLabel", {Size = UDim2.new(1, -22, 1, 0), BackgroundTransparency = 1, Text = label, TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local box = new("TextButton", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -14, 0.5, -7), BackgroundColor3 = cfgTable[key] and C.accent or C.track, Text = ""}, f)
    corner(box, 3)
    box.MouseButton1Click:Connect(function()
        cfgTable[key] = not cfgTable[key]
        box.BackgroundColor3 = cfgTable[key] and C.accent or C.track
    end)
end

local function miniCycle(parent, label, cfgTable, key, options)
    local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = C.track, Text = label .. ": " .. tostring(cfgTable[key]), TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 10, LayoutOrder = ord(parent)}, parent)
    corner(btn, 3)
    btn.MouseButton1Click:Connect(function()
        local idx = table.find(options, cfgTable[key]) or 0
        cfgTable[key] = options[(idx % #options) + 1]
        btn.Text = label .. ": " .. tostring(cfgTable[key])
    end)
end

local function miniNote(parent, text, h)
    new("TextLabel", {Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, TextWrapped = true, Text = text, TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = ord(parent)}, parent)
end

-- contentHeight = total height of what the builder adds (children + the gaps between them).
-- The keybind row (22px + 5px gap) and bottom padding (6px) are added automatically.
local function moduleRow(parent, name, cfgTable, key, contentHeight, settingsBuilder, onToggle)
    local HEAD_H = 26
    local total = (contentHeight or 0) + 27 + 6
    local container = new("Frame", {Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundTransparency = 1}, parent)

    local head = new("Frame", {Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundTransparency = 1}, container)
    local nameBtn = new("TextButton", {Size = UDim2.new(1, -26, 1, 0), BackgroundTransparency = 1, Text = name, TextColor3 = cfgTable[key] and C.accent or C.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, head)
    new("UIPadding", {PaddingLeft = UDim.new(0, 8)}, nameBtn)

    local dotsBtn = new("TextButton", {Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -24, 0.5, -11), BackgroundTransparency = 1, Text = ""}, head)
    for i = 0, 2 do
        local d = new("Frame", {Size = UDim2.new(0, 3, 0, 3), Position = UDim2.new(0.5, -1.5, 0, 4 + i * 6), BackgroundColor3 = C.dim, Name = "dot" .. i}, dotsBtn)
        corner(d, 2)
    end

    local settingsFrame = new("Frame", {Size = UDim2.new(1, 0, 0, total), Position = UDim2.new(0, 0, 0, HEAD_H), BackgroundTransparency = 1, Visible = false}, container)
    new("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 6)}, settingsFrame)
    new("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, settingsFrame)

    local entry = {bind = nil, name = name, cfgTable = cfgTable, key = key}
    modules[name] = entry
    local function refreshName() nameBtn.TextColor3 = cfgTable[key] and C.accent or C.text end
    entry.refresh = refreshName
    entry.toggle = function()
        cfgTable[key] = not cfgTable[key]
        refreshName()
        if onToggle then onToggle(cfgTable[key]) end
    end
    nameBtn.MouseButton1Click:Connect(entry.toggle)

    -- keybind button (first row of the settings panel)
    local bindBtn = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = C.track, Text = "", TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 10, LayoutOrder = ord(settingsFrame)}, settingsFrame)
    corner(bindBtn, 4)
    entry.updateBindText = function()
        bindBtn.Text = "Keybind: " .. (entry.bind and entry.bind.Name or "None") .. "  (click to set)"
    end
    local saved = savedBinds[name]
    if saved then
        local okKc, kc = pcall(function() return Enum.KeyCode[saved] end)
        if okKc and kc then entry.bind = kc end
    end
    entry.updateBindText()
    bindBtn.MouseButton1Click:Connect(function()
        listeningEntry = entry
        bindBtn.Text = "press a key...  (same key again = clear)"
    end)

    local expanded = false
    local function setDotColor(col)
        for _, d in ipairs(dotsBtn:GetChildren()) do
            if d:IsA("Frame") then d.BackgroundColor3 = col end
        end
    end
    dotsBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        settingsFrame.Visible = expanded
        container.Size = UDim2.new(1, 0, 0, HEAD_H + (expanded and total or 0))
        setDotColor(expanded and C.accent or C.dim)
    end)

    if settingsBuilder then settingsBuilder(settingsFrame) end
    return container
end

