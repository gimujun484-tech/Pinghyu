---------------------------------------------------------------- INPUT
conn(UIS.InputBegan, function(input, gpe)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then lastMouseDown = os.clock() end
    if listeningEntry and input.UserInputType == Enum.UserInputType.Keyboard then
        local e = listeningEntry
        listeningEntry = nil
        if input.KeyCode == Enum.KeyCode.Escape then
            -- cancel: keep whatever it was bound to
        elseif e.bind == input.KeyCode then
            e.bind = nil -- pressing the key it is already bound to clears it
        else
            e.bind = input.KeyCode
        end
        e.updateBindText()
        saveBinds()
        return
    end
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        for _, e in pairs(modules) do
            if e.bind and input.KeyCode == e.bind then e.toggle() end
        end
    end
end)

