---------------------------------------------------------------- TARGET CACHE
local function admit(o)
    if not o:IsA("BasePart") then return end
    if not o.Anchored or not o.CanCollide then return end
    if o.Size.Magnitude < 6 then return end
    local m = o:FindFirstAncestorOfClass("Model")
    if m and m:FindFirstChildOfClass("Humanoid") then return end
    Cache[o] = true
end
 
task.spawn(function()
    local n = 0
    for _, o in ipairs(Workspace:GetDescendants()) do
        if not alive then return end
        admit(o)
        n += 1
        if n % 400 == 0 then task.wait() end
    end
end)
conn(Workspace.DescendantAdded, admit)
conn(Workspace.DescendantRemoving, function(o) Cache[o] = nil end)
 
local function pickTarget(root)
    local T, F = Cfg.Target, Cfg.Farm
    local rp, now = root.Position, os.clock()
    local rangeSq, minSq = F.Range * F.Range, T.MinDist * T.MinDist
    local best, bestScore, count = nil, -math.huge, 0
    for part in pairs(Cache) do
        if part.Parent then
            local bl = Blacklist[part]
            if not bl or bl < now then
                if bl then Blacklist[part] = nil end
                local s, p = part.Size, part.Position
                local mag = s.Magnitude
                if mag >= T.MinSize and mag <= T.MaxSize and s.Y >= T.MinY and s.Y <= T.MaxY and p.Y <= T.MaxWorldY then
                    local d = p - rp
                    local dsq = d:Dot(d)
                    if dsq <= rangeSq and dsq >= minSq then
                        if F.Priority == "Random" then
                            count += 1
                            if math.random(count) == 1 then best = part end
                        else
                            local score = (F.Priority == "Largest") and mag or -dsq
                            if score > bestScore then bestScore, best = score, part end
                        end
                    end
                end
            end
        end
    end
    return best
end
 
---------------------------------------------------------------- AUTOFARM
conn(RunService.Heartbeat, function()
    local F = Cfg.Farm
    if not F.Enabled then State.target = nil return end
    local root = getRoot()
    if not root then return end
    local now = os.clock()
    local t = State.target
 
    if t then
        if not t.Parent then
            t = nil
        elseif F.TargetTimeout > 0 and now - State.since > F.TargetTimeout then
            Blacklist[t] = now + F.BlacklistTime
            t = nil
        elseif (t.Position - root.Position).Magnitude > F.Range + 20 then
            t = nil
        end
    end
 
    if not t then
        State.target = nil
        if now - State.lastPick < F.RetargetCD then return end
        State.lastPick = now
        t = pickTarget(root)
        if not t then return end
        State.target, State.since = t, now
        local off = Vector3.new(root.Position.X - t.Position.X, 0, root.Position.Z - t.Position.Z)
        State.side = off.Magnitude > 0.5 and off.Unit or Vector3.xAxis
    end
 
    local pos = t.Position
    local edge = math.max(t.Size.X, t.Size.Z) * 0.5
    local desired = pos + State.side * (edge + F.SideDist) + Vector3.new(0, F.Height, 0)
    if (root.Position - desired).Magnitude > F.RepositionThreshold then
        root.CFrame = CFrame.new(desired, pos)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end)
 
---------------------------------------------------------------- SKILLS
local lastPress = {}
local function pressKey(k, hold)
    pcall(function()
        VIM:SendKeyEvent(true, KEYCODES[k], false, game)
        task.wait(hold)
        VIM:SendKeyEvent(false, KEYCODES[k], false, game)
    end)
end
 
task.spawn(function()
    while alive do
        local S = Cfg.Skills
        task.wait(math.max(S.CycleInterval, 0.05))
        local go = S.Enabled
        if not go and Cfg.Farm.Enabled and State.target then
            local root = getRoot()
            if root then go = (State.target.Position - root.Position).Magnitude <= S.Range end
        end
        if go then
            for _, k in ipairs(SKILL_ORDER) do
                if not alive then break end
                if S.Keys[k] and os.clock() - (lastPress[k] or 0) >= S.Cooldowns[k] then
                    lastPress[k] = os.clock()
                    pressKey(k, S.HoldTime)
                    task.wait(S.KeyGap)
                end
            end
        end
    end
end)
 
---------------------------------------------------------------- ENERGY
local hooked = {}
local energyObjs = {}
 
local function parseKeywords()
    local list = {}
    for w in string.gmatch(string.lower(Cfg.Misc.EnergyKeywords), "[^,%s]+") do list[#list + 1] = w end
    return list
end
 
local function nameMatches(name, kws)
    name = string.lower(name)
    for _, w in ipairs(kws) do
        if string.find(name, w, 1, true) then return true end
    end
    return false
end
 
local function scanEnergy()
    local kws = parseKeywords()
    energyObjs = {}
    if #kws == 0 then return end
    local function check(o)
        if (o:IsA("NumberValue") or o:IsA("IntValue")) and nameMatches(o.Name, kws) then
            energyObjs[#energyObjs + 1] = o
            if not hooked[o] then
                hooked[o] = true
                conn(o:GetPropertyChangedSignal("Value"), function()
                    if Cfg.Misc.InfEnergy and o.Value < Cfg.Misc.EnergyValue * 0.5 then
                        o.Value = Cfg.Misc.EnergyValue
                    end
                end)
            end
        end
    end
    for _, o in ipairs(LP:GetDescendants()) do check(o) end
    local c = LP.Character
    if c then for _, o in ipairs(c:GetDescendants()) do check(o) end end
end
 
local function forceEnergy()
    local v, kws = Cfg.Misc.EnergyValue, parseKeywords()
    for _, o in ipairs(energyObjs) do
        if o.Parent then pcall(function() o.Value = v end) end
    end
    local function attrs(inst)
        if not inst then return end
        for name, val in pairs(inst:GetAttributes()) do
            if type(val) == "number" and nameMatches(name, kws) then inst:SetAttribute(name, v) end
        end
    end
    attrs(LP.Character)
    attrs(LP)
end
 
task.spawn(function()
    task.wait(2)
    while alive do
        if Cfg.Misc.InfEnergy then pcall(scanEnergy) end
        task.wait(4)
    end
end)
task.spawn(function()
    while alive do
        if Cfg.Misc.InfEnergy then pcall(forceEnergy) end
        task.wait(0.2)
    end
end)
conn(LP.CharacterAdded, function()
    task.wait(1.5)
    pcall(scanEnergy)
end)
 
---------------------------------------------------------------- MOVEMENT
local flying = false
conn(RunService.RenderStepped, function(dt)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local M = Cfg.Move
 
    if M.ApplySpeed then
        if hum.WalkSpeed ~= M.WalkSpeed then hum.WalkSpeed = M.WalkSpeed end
        pcall(function()
            hum.UseJumpPower = true
            if hum.JumpPower ~= M.Jump then hum.JumpPower = M.Jump end
        end)
    end
 
    if M.Fly then
        flying = true
        hum.PlatformStand = true
        local cam, dir = Camera.CFrame, Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
        if dir.Magnitude > 0 then
            root.CFrame = root.CFrame + dir.Unit * M.FlySpeed * dt
        end
        root.AssemblyLinearVelocity = Vector3.zero
    elseif flying then
        flying = false
        hum.PlatformStand = false
    end
end)
 
conn(RunService.Stepped, function()
    if not Cfg.Move.Noclip then return end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end)
 
