    end
end)

---------------------------------------------------------------- REMOTE SPY
-- Logs what the game sends to the server when YOU do something (swing, break a bed block).
-- Turn it on, do the action once manually, and read the console: that shows the real attack /
-- block-break remote, which is what a true in-game kill aura / reach / bed breaker has to call.
local hookInstalled = false
local spyQueue = {}
local SPY_NOISE = {"ismoving", "camera", "heartbeat", "ping", "updateattribute"}

local function fmtVal(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "string" then return '"' .. v .. '"' end
    if t == "Instance" then
        local ok, n = pcall(function() return v:GetFullName() end)
        return ok and n or tostring(v)
    end
    if t == "table" then
        if depth >= 2 then return "{...}" end
        local parts, n = {}, 0
        for k, val in pairs(v) do
            n += 1
            if n > 8 then parts[#parts + 1] = "..." break end
            parts[#parts + 1] = tostring(k) .. "=" .. fmtVal(val, depth + 1)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function installHook()
    if hookInstalled then return end
    if not hookmetamethod or not getnamecallmethod or not newcclosure then
        warn("[BadFight] executor lacks hookmetamethod/getnamecallmethod/newcclosure: held-item tracking and Remote Spy are unavailable.")
        return
    end
    local ok, err = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
                if method == "FireServer" and self.Name == "EquipTool" then
                    local first = ...
                    trackEquip(first)
                end
                if Cfg_Spy.Enabled and alive and #spyQueue < 200 then
                    spyQueue[#spyQueue + 1] = {self, method, table.pack(...)}
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then
        hookInstalled = true
    else
        warn("[BadFight] hook failed: " .. tostring(err))
    end
end
installHook()

task.spawn(function()
    local lastLine, lastAt = "", 0
    while alive do
        task.wait(0.1)
        while #spyQueue > 0 do
            local item = table.remove(spyQueue, 1)
            local okName, full = pcall(function() return item[1]:GetFullName() end)
            full = okName and full or tostring(item[1])
            local parts = {}
            for i = 1, item[3].n do parts[i] = fmtVal(item[3][i]) end
            local line = ("[Spy] %s :%s( %s )"):format(full, item[2], table.concat(parts, ", "))
            local lower = string.lower(line)
            local noisy = false
            for _, w in ipairs(SPY_NOISE) do
                if string.find(lower, w, 1, true) then noisy = true break end
            end
            if not noisy and (line ~= lastLine or os.clock() - lastAt > 0.5) then
                print(line)
                lastLine, lastAt = line, os.clock()
            end
        end
    end
end)

