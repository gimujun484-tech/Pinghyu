local function cycle(page, text, path, options)
    local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = C.item, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 12}, page)
    corner(btn)
    local function refresh() local t, k = ref(path) btn.Text = text .. ":  " .. tostring(t[k]) .. "  (click)" end
    btn.MouseButton1Click:Connect(function()
        local t, k = ref(path)
        local idx = table.find(options, t[k]) or 0
        t[k] = options[(idx % #options) + 1]
        refresh()
    end)
    refreshers[#refreshers + 1] = refresh
    refresh()
end
 
