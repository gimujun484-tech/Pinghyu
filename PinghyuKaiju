---------------------------------------------------------------- MOVEMENT
local flying = false
local spaceWasDown = false
conn(RunService.RenderStepped, function(dt)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local M = Cfg.Move
 
    if M.ApplySpeed then
        -- method 1: standard Humanoid properties (works if the game uses stock movement)
        if hum.WalkSpeed ~= M.WalkSpeed then hum.WalkSpeed = M.WalkSpeed end
        pcall(function() hum.UseJumpPower = true end)
        if hum.JumpPower ~= M.Jump then pcall(function() hum.JumpPower = M.Jump end) end
        pcall(function() hum.JumpHeight = M.Jump end)
 
        -- method 2: direct physics push based on WASD, independent of Humanoid entirely.
        -- Covers games (common for giant-creature games like this one) that drive movement
        -- with their own controller and ignore WalkSpeed completely. Only kicks in when
        -- a movement key is actually held, and only touches horizontal velocity so gravity
        -- and jump arcs aren't disturbed.
        if not M.Fly then
            local cam = Camera.CFrame
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude > 0.1 then
                local v = root.AssemblyLinearVelocity
                local push = dir.Unit * M.WalkSpeed
                root.AssemblyLinearVelocity = Vector3.new(push.X, v.Y, push.Z)
            end
 
            -- forced jump: on Space press (not held, so it doesn't fling you endlessly),
            -- set a strong upward velocity directly rather than relying on JumpPower.
            if UIS:IsKeyDown(Enum.KeyCode.Space) and not spaceWasDown then
                local v = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v.X, M.Jump, v.Z)
            end
        end
        spaceWasDown = UIS:IsKeyDown(Enum.KeyCode.Space)
    end
 
    if M.Fly then
        flying = true
        hum.PlatformStand = true
        local cam, dir = Camera.CFrame, Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
        if dir.Magnitude > 0 then
            root.CFrame = root.CFrame + dir.Unit * M.FlySpeed * dt
        end
        root.AssemblyLinearVelocity = Vector3.zero
    elseif flying then
        flying = false
        hum.PlatformStand = false
    end
end)
 
local noclipOriginal = {}
conn(RunService.Stepped, function()
    local char = LP.Character
    if not char then return end
    if Cfg.Move.Noclip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if noclipOriginal[p] == nil then noclipOriginal[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    elseif next(noclipOriginal) ~= nil then
        -- noclip was just turned off: restore every part we touched, then forget them
        for p, wasCollide in pairs(noclipOriginal) do
            if p and p.Parent then pcall(function() p.CanCollide = wasCollide end) end
        end
        noclipOriginal = {}
    end
end)
