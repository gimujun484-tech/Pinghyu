local function toggle(page, text, path, cb)
    local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = C.off, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 12}, page)
