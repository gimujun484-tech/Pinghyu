---------------------------------------------------------------- BED BREAKER (passive)
-- No teleporting. When you walk within SwingRange of a bed, it fires the game MineBlock remote
-- at it (same arguments the game sends: pickaxe name, the bed, its grid position, ray origin,
-- ray direction). If you are holding something else it briefly equips the pickaxe, then puts your
-- item back once you walk away. Beds covered by blocks may still need those blocks broken first.
local bedCache = {}
local lastBedSwing, lastBedActive, lastBedDebug = 0, 0, 0
local breakerSwapped, breakerPrev, breakerPrevKnown = false, nil, false

task.spawn(function()
    while alive do
        local fresh = {}
        local container = workspace:FindFirstChild("BedsContainer")
        if container then
            for _, b in ipairs(container:GetChildren()) do fresh[#fresh + 1] = b end
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and string.find(string.lower(obj.Name), "bed", 1, true) then
                    fresh[#fresh + 1] = obj
                end
            end
        end
        bedCache = fresh
        task.wait(container and 1 or 3)
    end
end)

local function bedPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        if ok then return pivot end
    end
    return nil
end

local function isOwnBed(obj)
    if not LP.Team then return false end
    for _, attr in ipairs({"Team", "TeamName", "team"}) do
        local v = obj:GetAttribute(attr)
        if type(v) == "string" and v == LP.Team.Name then return true end
    end
    return false
end

conn(RunService.Heartbeat, function()
    if not Cfg_Breaker.Enabled then return end
    local root = getRoot()
    if not root then return end
    local now = os.clock()

    local targetBed, targetPos
    for _, bed in ipairs(bedCache) do
        if bed.Parent and not isOwnBed(bed) then
            local p = bedPos(bed)
            if p and (p - root.Position).Magnitude <= Cfg_Breaker.SwingRange then
                targetBed, targetPos = bed, p
                break
            end
        end
    end

    if not targetBed then
        if now - lastBedDebug > 3 then
            lastBedDebug = now
            local nearest, nd = nil, math.huge
            for _, bed in ipairs(bedCache) do
                local bp = bed.Parent and bedPos(bed)
                if bp then
                    local d2 = (bp - root.Position).Magnitude
                    if d2 < nd then nearest, nd = bed, d2 end
                end
            end
            if nearest then
                print(("[BedBreaker] no bed within %d studs. Nearest is %.1f studs away (%s)."):format(Cfg_Breaker.SwingRange, nd, nearest:GetFullName()))
            else
                print("[BedBreaker] no beds found (BedsContainer missing or empty).")
            end
        end
        if breakerSwapped and now - lastBedActive > 0.6 then
            breakerSwapped = false
            local equip = getItemRemote("EquipTool")
            if equip and breakerPrevKnown then
                pcall(function()
                    if breakerPrev then equip:FireServer(breakerPrev) else equip:FireServer() end
                end)
            end
            breakerPrev = nil
        end
        return
    end
    lastBedActive = now

    local mine = getItemRemote("MineBlock")
    if not mine then
        logOnce("nomine", "ReplicatedStorage.Remotes.ItemsRemotes.MineBlock was not found.")
        return
    end

    local pick = pickaxeName()
    if not breakerSwapped and currentItem ~= pick then
        local equip = getItemRemote("EquipTool")
        if equip then
            breakerPrev, breakerPrevKnown = currentItem, itemKnown
            breakerSwapped = true
            pcall(function() equip:FireServer(pick) end)
        end
    end

    if now - lastBedSwing < MINE_INTERVAL then return end
    lastBedSwing = now

    local origin = root.Position + Vector3.new(0, 1.5, 0)
    local dir = targetPos - origin
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    pcall(function()
        mine:FireServer(pick, targetBed,
            math.round(targetPos.X), math.round(targetPos.Y), math.round(targetPos.Z),
            origin.X, origin.Y, origin.Z, dir.X, dir.Y, dir.Z)
    end)
    logOnce("mine", "MineBlock -> bed with " .. pick)
end)

pcall(function()
    if getgenv then
        getgenv().PrintAllBeds = function()
            print("[BedBreaker] beds known to the script:")
            for _, b in ipairs(bedCache) do
                local p = bedPos(b)
