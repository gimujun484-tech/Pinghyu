-- inventory data: only what the game actually exposes to your client
local function inventoryItems(plr)
    local counts, order = {}, {}
    local function add(name, n)
        if n <= 0 then return end
        if not counts[name] then counts[name] = 0; order[#order + 1] = name end
        counts[name] += n
    end
    local char = plr.Character
    if char then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") or kwMatch("sword,pickaxe,shears,wool", c.Name) then add(c.Name, 1) end
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") then add(c.Name, 1) end
        end
    end
    local holders = {}
    local function push(v) if v then holders[#holders + 1] = v end end
    push(plr)
    push(char)
    local rs = game:GetService("ReplicatedStorage")
    push(rs:FindFirstChild(plr.Name))
    for _, dataRoot in ipairs({"PlayerData", "Inventories", "Inventory", "Data"}) do
        local d = rs:FindFirstChild(dataRoot)
        if d then push(d:FindFirstChild(plr.Name)) end
    end
    for _, holder in ipairs(holders) do
        for _, c in ipairs(holder:GetChildren()) do
            if (c:IsA("Folder") or c:IsA("Configuration")) and kwMatch("inv,item,hotbar,backpack,tools", c.Name) then
                for _, v in ipairs(c:GetChildren()) do
                    if v:IsA("IntValue") or v:IsA("NumberValue") then
                        add(v.Name, math.floor(v.Value))
                    else
                        add(v.Name, 1)
                    end
                end
            end
        end
    end
    local out = {}
    for _, n in ipairs(order) do out[#out + 1] = {name = n, count = counts[n]} end
    return out
end

-- item icons: looks for the picture the game itself uses (hotbar / shop images next to the item
-- name, or an Image/Icon value on the item definition). If none is found it shows a coloured
-- square with the item initials instead. PrintItemIcons() in the console shows what it found.
local ICON_KEYS = {image = true, icon = true, thumbnail = true, imageid = true, textureid = true, assetid = true, decal = true}
local iconCache = {}

local function looksLikeImage(v)
    return type(v) == "string" and (string.find(v, "rbxassetid", 1, true) or string.find(v, "rbxasset://", 1, true) or string.find(v, "http", 1, true) or string.match(v, "^%d+$")) ~= nil
end
local function normalizeImage(v)
    if string.match(v, "^%d+$") then return "rbxassetid://" .. v end
    return v
end
local function iconFromInstance(inst)
    if inst:IsA("Tool") and inst.TextureId ~= "" then return inst.TextureId end
    if (inst:IsA("ImageLabel") or inst:IsA("ImageButton")) and inst.Image ~= "" then return inst.Image end
    for k, v in pairs(inst:GetAttributes()) do
        if ICON_KEYS[string.lower(k)] and looksLikeImage(v) then return normalizeImage(v) end
    end
    for _, c in ipairs(inst:GetChildren()) do
        if ICON_KEYS[string.lower(c.Name)] then
            if c:IsA("StringValue") and looksLikeImage(c.Value) then return normalizeImage(c.Value) end
            if c:IsA("IntValue") or c:IsA("NumberValue") then return "rbxassetid://" .. tostring(math.floor(c.Value)) end
            if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" then return c.Image end
            if c:IsA("Decal") or c:IsA("Texture") then return c.Texture end
        end
    end
    return nil
end
local function searchIcon(name)
    local lname = string.lower(name)
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
                local par = o.Parent
                if string.lower(o.Name) == lname or (par and string.lower(par.Name) == lname) then return o.Image end
            end
        end
    end
    local n = 0
    for _, o in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        n += 1
        if n > 20000 then break end
        if string.lower(o.Name) == lname then
            local img = iconFromInstance(o)
            if img then return img end
        end
    end
    return nil
end
local function getIcon(name)
    local cached = iconCache[name]
    if cached ~= nil then return cached or nil end
    iconCache[name] = false
    task.spawn(function()
        local ok, img = pcall(searchIcon, name)
        if ok and img then iconCache[name] = img end
    end)
    return nil
end

local function slotColor(name)
    local h = 0
    for k = 1, #name do h = (h * 31 + string.byte(name, k)) % 360 end
    return Color3.fromHSV(h / 360, 0.55, 0.8)
end
local function initials(name)
    local out = {}
    for word in string.gmatch(name, "%S+") do out[#out + 1] = string.upper(string.sub(word, 1, 1)) end
    return string.sub(table.concat(out), 1, 2)
end

local function entryFor(plr)
    local e = espEntries[plr]
    if e then return e end
    local box = new("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false}, ESPGui)
    local stroke = new("UIStroke", {Thickness = 2, Color = Color3.fromRGB(235, 70, 70), ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, box)
    local tag = new("TextLabel", {BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 13, TextStrokeTransparency = 0.3, Size = UDim2.new(0, 240, 0, 16), Visible = false}, ESPGui)
    local invFrame = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(0.5, 0), Visible = false}, ESPGui)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center}, invFrame)
    e = {box = box, stroke = stroke, tag = tag, invFrame = invFrame, invKey = "", invAt = 0, items = {}}
    espEntries[plr] = e
    return e
end
local function dropEntry(plr)
    local e = espEntries[plr]
    if e then
        pcall(function() e.box:Destroy() e.tag:Destroy() e.invFrame:Destroy() end)
        espEntries[plr] = nil
    end
end

local function renderInventory(e, items)
    local parts, icons = {}, {}
    for _, it in ipairs(items) do
        parts[#parts + 1] = it.name .. ":" .. it.count
        icons[#icons + 1] = iconCache[it.name] and "1" or "0"
    end
    local key = table.concat(parts, "|") .. "#" .. table.concat(icons)
    if key == e.invKey then return end
    e.invKey = key
    for _, c in ipairs(e.invFrame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for i, it in ipairs(items) do
        if i > 8 then break end
        local slot = new("Frame", {Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, LayoutOrder = i}, e.invFrame)
        corner(slot, 5)
        new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center}, slot)
        new("UIPadding", {PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 4)}, slot)
        local img = getIcon(it.name)
        if img then
            new("ImageLabel", {Size = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1, Image = img, LayoutOrder = 1}, slot)
        else
            local ph = new("TextLabel", {Size = UDim2.new(0, 20, 0, 20), BackgroundColor3 = slotColor(it.name), Text = initials(it.name), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 9, LayoutOrder = 1}, slot)
            corner(ph, 4)
        end
        if it.count > 1 then
            new("TextLabel", {Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "x" .. it.count, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 12, LayoutOrder = 2}, slot)
        end
    end
end

conn(RunService.RenderStepped, function()
    if not (Cfg_ESP.Enabled or Cfg_Tags.Enabled or Cfg_Inv.Enabled) then
        for plr in pairs(espEntries) do dropEntry(plr) end
        return
    end
    local cam = workspace.CurrentCamera
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and (Cfg_ESP.ShowTeammates or not isTeammate(plr)) then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hroot = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hroot and hum.Health > 0 then
                local dist = (hroot.Position - cam.CFrame.Position).Magnitude
                if dist <= Cfg_ESP.MaxDistance then
                    seen[plr] = true
                    local e = entryFor(plr)
                    local pos, onScreen = cam:WorldToViewportPoint(hroot.Position)
                    if onScreen and pos.Z > 0 then
                        local top = cam:WorldToViewportPoint(hroot.Position + Vector3.new(0, 3, 0))
                        local bot = cam:WorldToViewportPoint(hroot.Position - Vector3.new(0, 3.2, 0))
                        local h = math.abs(top.Y - bot.Y)
                        local w = h * 0.55

                        e.box.Visible = Cfg_ESP.Enabled
                        if Cfg_ESP.Enabled then
                            e.stroke.Color = espColorFor(plr)
                            e.box.Size = UDim2.new(0, w, 0, h)
                            e.box.Position = UDim2.new(0, pos.X - w / 2, 0, top.Y)
                        end

                        e.tag.Visible = Cfg_Tags.Enabled
                        if Cfg_Tags.Enabled then
                            local text = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
                            if Cfg_Tags.ShowHealth then text = text .. " [" .. math.floor(hum.Health) .. "hp]" end
                            if Cfg_Tags.ShowDistance then text = text .. " " .. math.floor(dist) .. "m" end
                            e.tag.Text = text
                            e.tag.TextColor3 = espColorFor(plr)
                            e.tag.Position = UDim2.new(0, pos.X - 120, 0, top.Y - 18)
                        end

                        e.invFrame.Visible = Cfg_Inv.Enabled
                        if Cfg_Inv.Enabled then
                            if os.clock() - e.invAt > 0.5 then
                                e.invAt = os.clock()
                                e.items = inventoryItems(plr)
                            end
                            renderInventory(e, e.items)
                            e.invFrame.Position = UDim2.new(0, pos.X, 0, bot.Y + 4)
                        end
                    else
                        e.box.Visible, e.tag.Visible, e.invFrame.Visible = false, false, false
                    end
                end
            end
        end
    end
    for plr in pairs(espEntries) do
        if not seen[plr] then dropEntry(plr) end
    end
end)

