---------------------------------------------------------------- GODMODE
-- Forces Health back to Max the instant it drops. Not a true server-side invincibility -
-- if the server tracks health authoritatively and applies lethal damage in one shot before
-- this can react, or the game removes you from the match server-side on hit, this won't save you.
-- But for anything that damages you incrementally, it effectively negates it.
--
-- GodModeUntouchable additionally sets CanTouch/CanQuery false on your own parts, so enemy
-- melee (Touched-based) and hitscan/raycast (FindPartOnRay-based) attacks skip over you at the
-- detection stage - before any damage remote even fires. This is the "bedwars-style" part:
-- most PvP damage in these games starts from your hitbox being found, so removing yourself
-- from that search is stronger than reacting to damage after the fact.
local godHooked = {}
local untouchableApplied = {}
 
local function applyUntouchable(char, on)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if on then
                if untouchableApplied[p] == nil then
                    untouchableApplied[p] = {CanTouch = p.CanTouch, CanQuery = p.CanQuery}
                end
                p.CanTouch = false
                p.CanQuery = false
            elseif untouchableApplied[p] then
                p.CanTouch = untouchableApplied[p].CanTouch
                p.CanQuery = untouchableApplied[p].CanQuery
            end
        end
    end
    if not on then untouchableApplied = {} end
end
 
local function hookGodmode(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or godHooked[hum] then return end
    godHooked[hum] = true
    conn(hum:GetPropertyChangedSignal("Health"), function()
        if Cfg.Misc.GodMode and hum.Health < hum.MaxHealth and hum.Health > 0 then
            hum.Health = hum.MaxHealth
        end
    end)
end
 
local wasUntouchable = false
conn(RunService.Heartbeat, function()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
 
    if hum and Cfg.Misc.GodMode then
        hookGodmode(char)
        if hum.Health < hum.MaxHealth and hum.Health > 0 then
            hum.Health = hum.MaxHealth
        end
    end
 
    if char then
        local want = Cfg.Misc.GodMode and Cfg.Misc.GodModeUntouchable
        if want and not wasUntouchable then
            applyUntouchable(char, true)
            wasUntouchable = true
        elseif not want and wasUntouchable then
            applyUntouchable(char, false)
            wasUntouchable = false
        elseif want then
            -- catch newly-added parts (e.g. accessories that load in late)
            applyUntouchable(char, true)
        end
    end
end)
 
conn(LP.CharacterAdded, function(char)
    task.wait(0.2)
    hookGodmode(char)
    wasUntouchable = false
end)
if LP.Character then hookGodmode(LP.Character) end
 
---------------------------------------------------------------- AUTOPLAY (auto-respawn)
-- On death, waits a moment then tries LP:LoadCharacter(). If that doesn't bring you back
-- (some games gate respawn behind a UI button or a delay/vote), it also scans PlayerGui for
-- any button whose name or text suggests "respawn/revive/continue" and clicks it directly.
local function tryClickRespawnButtons()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local keywords = {"respawn", "revive", "continue", "rejoin", "playagain"}
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local hay = string.lower(obj.Name .. " " .. (obj:IsA("TextButton") and obj.Text or ""))
            for _, kw in ipairs(keywords) do
                if string.find(hay, kw, 1, true) then
                    pcall(function()
                        if firesignal then
                            firesignal(obj.MouseButton1Click)
                        else
                            local pos = obj.AbsolutePosition + obj.AbsoluteSize / 2
                            VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                            task.wait(0.05)
                            VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                        end
                    end)
                    break
                end
            end
        end
    end
end
 
conn(LP.CharacterAdded, function(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    conn(hum.Died, function()
        if not Cfg.Misc.AutoPlay then return end
        task.spawn(function()
            task.wait(Cfg.Misc.AutoPlayRespawnDelay)
            pcall(function() LP:LoadCharacter() end)
        end)
    end)
end)
 
task.spawn(function()
    while alive do
        task.wait(1)
        if Cfg.Misc.AutoPlay and Cfg.Misc.AutoPlayClickButtons then
            pcall(tryClickRespawnButtons)
        end
    end
end)
 
---------------------------------------------------------------- INVISIBILITY
-- Pure visual: sets every part/decal's Transparency to 1 so other clients render you as
-- invisible. This isn't gated by server stat validation the way Health/WalkSpeed are, so
-- it should work even in games that fight back on other hacks. Re-applies continuously to
-- catch new accessories/respawns.
local invisOriginal = {}
local function applyInvisible(char, on)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") or p:IsA("Decal") or p:IsA("Texture") then
            if on then
                if invisOriginal[p] == nil then invisOriginal[p] = p.Transparency end
                if p.Name ~= "HumanoidRootPart" then p.Transparency = 1 end
            elseif invisOriginal[p] ~= nil then
                p.Transparency = invisOriginal[p]
            end
        end
    end
    if not on then invisOriginal = {} end
end
 
local wasInvisible = false
conn(RunService.Heartbeat, function()
    local char = LP.Character
    if not char then return end
    local want = Cfg.Misc.Invisible
    if want ~= wasInvisible then
        applyInvisible(char, want)
        wasInvisible = want
    elseif want then
        applyInvisible(char, true) -- catch newly streamed-in parts
    end
end)
conn(LP.CharacterAdded, function() wasInvisible = false end)
 
---------------------------------------------------------------- SKY HIDE
-- Actually moves your character far above the map so you're out of render/interaction
-- range for everyone else - a real hide, not a visual trick. Trade-off: your real position
-- (used for all server-side checks) is now up there too, so farm/hunt/skills go idle while
-- this is on. Toggling off teleports you back to where you were.
local skyHideReturn = nil
local skyHideActive = false
 
conn(RunService.Heartbeat, function()
    local root = getRoot()
    if not root then return end
 
    if Cfg.Misc.SkyHide and not skyHideActive then
        skyHideReturn = root.CFrame
        skyHideActive = true
    elseif not Cfg.Misc.SkyHide and skyHideActive then
        if skyHideReturn then
            root.CFrame = skyHideReturn
            root.AssemblyLinearVelocity = Vector3.zero
        end
        skyHideActive = false
        skyHideReturn = nil
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and not Cfg.Move.Fly then hum.PlatformStand = false end
    end
 
    if Cfg.Misc.SkyHide then
        local pos = root.Position
        local desiredY = Cfg.Misc.SkyHeight
        if math.abs(pos.Y - desiredY) > 10 then
            root.CFrame = CFrame.new(pos.X, desiredY, pos.Z)
        end
        root.AssemblyLinearVelocity = Vector3.zero
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
